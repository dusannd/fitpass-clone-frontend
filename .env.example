# Copy this file to .env and fill in the values. .env itself is git-ignored.
#
# Every VITE_* variable is inlined by Vite at BUILD time, not read at runtime.
# Setting one in a container's environment does nothing — the bundle was already
# finalised. In production these have to be passed as build args.

# Where the frontend sends API calls. RELATIVE ON PURPOSE — do not change it to an
# absolute URL. In dev it goes through the Vite proxy in vite.config.ts, in
# production through Nginx. Same-origin either way, so CORS never comes up and the
# API host never has to be known at build time.
VITE_API_BASE_URL=/api

# Turns the reCAPTCHA widget on the login and register forms on or off.
# Keep it false locally so the forms work without contacting Google.
VITE_FEATURE_RECAPTCHA=false

# The reCAPTCHA v2 site key. Public by design — it is rendered into the page.
# The matching RECAPTCHA_SECRET belongs to the backend and never appears here.
# Only needed when VITE_FEATURE_RECAPTCHA=true.
VITE_RECAPTCHA_SITE_KEY=
